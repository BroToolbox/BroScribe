target/
/third_party/sherpa-onnx/lib/
/third_party/sherpa-onnx/lib-*/
/third_party/sherpa-onnx/*.part.*
# generated by running the Python scripts and their tests
__pycache__/
*.py[cod]
.DS_Store
.claude/
.pi/
# local data that must never be committed: recordings, databases, models
*.m4a
*.aac
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.mp4
*.m4v
*.mov
*.mkv
*.webm
*.sqlite
*.sqlite-*
*.db
*.onnx
*.gguf
*.bin
*.tar.bz2
# synthetic or openly licensed test fixtures are allowed
!**/tests/fixtures/**
# private notes and secrets must never be committed, fixtures included
*.private.*
.env*
